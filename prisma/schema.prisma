// MAFERSA — Control de stock
// Modelo mínimo: usuarios, productos y cambios de cantidad (historial).
// Login simple por usuario + contraseña, sesión JWT (sin tablas de sesión).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id           String           @id @default(cuid())
  username     String           @unique // login (ej. "maximo")
  name         String // nombre visible (ej. "Máximo")
  passwordHash String
  role         Role             @default(EMPLOYEE)
  lastLoginAt  DateTime?
  changes      QuantityChange[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("users")
}

model Product {
  id           String           @id @default(cuid())
  internalCode String?          @unique // CÓD.MAF (código interno)
  factoryCode  String? // CÓD.FÁBRICA (código de fábrica, puede repetirse)
  brand        String?
  name         String
  quantity     Int              @default(0) // stock actual (>= 0)
  changes      QuantityChange[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([name])
  @@index([brand])
  @@index([factoryCode])
  @@map("products")
}

model QuantityChange {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  before    Int
  after     Int
  delta     Int
  note      String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([userId])
  @@map("quantity_changes")
}
